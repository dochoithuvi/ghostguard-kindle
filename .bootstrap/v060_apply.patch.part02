-    f.issued_at = trim(f.issued_at)
-    f.expire = trim(f.expire):lower()
-    f.features = trim(f.features):lower():gsub("%s", "")
-    f.license_id = trim(f.license_id)
-    f.key_id = trim(f.key_id)
