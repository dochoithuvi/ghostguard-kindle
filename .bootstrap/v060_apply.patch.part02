-function LicenseManager:new(config, storage, plugin_dir, device_id)
-    local crypto_ok, crypto = pcall(dofile, plugin_dir .. "license_crypto.lua")
-    return setmetatable({
-        config = config,
-        crypto = crypto_ok and crypto or nil,
